
fn makeMaze(width, height)
{

    const maze = {
        width: width,
        height: height,
        grid: []
    };

    for(let y = 0; y < height; y++) {
        const row = [];
        for(let x = 0; x < width; x++) {
            row.push({
                x:x,
                y:y,
                visited:false,
                walls:{
                    top:true,
                    right:true,
                    bottom:true,
                    left:true
                }
            });
        }

        maze.grid.push(row);
    }

    maze.set("getCell", (x, y) => {
        if(x < 0 || y < 0 || x >= maze.width || y >= maze.height)
            return undefined;

        return maze.grid[x][y];
    });

    maze.set("getNeighbors", (cell) => {
        const res = [];
        const dirs = [
            {dx:0,dy:-1,wall:'top',opp:'bottom'},
            {dx:1,dy:0,wall:'right',opp:'left'},
            {dx:0,dy:1,wall:'bottom',opp:'top'},
            {dx:-1,dy:0,wall:'left',opp:'right'}
        ];

        for(let i=0;i<dirs.length;i++){
            const d = dirs[i];
            const nx = cell.x+d.dx;
            const ny = cell.y+d.dy;
            const n = maze.getCell(nx,ny);
            if(n !== undefined && !n.visited){
                res.push({cell:n,wall:d.wall,opp:d.opp});
            }
        }
        return res;
    });

    maze.set("generate", () => {

        const stack = [];
        const start = maze.getCell(0,0);

        start.visited = true;
        stack.push(start);

        while(stack.length>0){
            const current = stack[stack.length-1];
            const neigh = maze.getNeighbors(current);
            if(neigh.length>0){
                const rnd = math.trunc(math.random(0, neigh.length));
                const choice = neigh[rnd];

                current.walls[choice.wall] = false;
                choice.cell.walls[choice.opp] = false;
                choice.cell.visited = true;
                stack.push(choice.cell);
            } else {
                stack.pop();
            }
        }

        for(let y=0;y<maze.height;y++) 
            for(let x=0;x<maze.width;x++) 
                maze.grid[y][x].visited=false;

    });

    maze.set("print", () => {
        let out = "";
        for (let x = 0; x < maze.width; x++) 
            out += " _";

        console.log(out);

        for (let y = 0; y < maze.height; y++) {
            let row = "|";
            for (let x = 0; x < maze.width; x++) {
                const cell = maze.grid[y][x];
                const bottom = cell.walls.bottom ? "_" : " ";
                const right = cell.walls.right ? "|" : " ";
                row += bottom + right;
            }
            console.log(row);
        }
    });

    return maze;

}

fn main() {
    const maze = makeMaze(25, 25);

    maze.generate();
    maze.print();
}